@model MCBA.ViewModels.TransferViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>Transfer</h2>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form asp-action="Index" method="post">
                <div class="mb-3">
                    <label asp-for="SourceAccountNumber" class="form-label">From Account</label>
                    <select asp-for="SourceAccountNumber" class="form-select">
                        <option value="">-- Select source account --</option>
                        @if (Model.Accounts != null)
                        {
                            @foreach (var account in Model.Accounts)
                            {
                                <option value="@account.AccountNumber">
                                    @(account.AccountType == 'C' ? "Checking" : "Savings") - @account.AccountNumber (Balance: @account.Balance.ToString("C"), Free Transactions: @account.FreeTransactions)
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DestinationAccountNumber" class="form-label">To Account Number</label>
                    <input asp-for="DestinationAccountNumber" type="number" class="form-control" />
                    <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                    <small class="form-text text-muted">
                        Enter a 4-digit account number
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label">Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" min="0.01" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                    <small class="form-text text-muted">
                        Service charge: $0.05 (waived if you have free transactions remaining)
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="Comment" class="form-label">Comment (Optional, max 30 characters)</label>
                    <input asp-for="Comment" type="text" class="form-control" maxlength="30" />
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Continue</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>