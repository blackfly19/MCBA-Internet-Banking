@model MCBA.ViewModels.DepositViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>Confirm Deposit</h2>
            <hr />

            <div class="card">
                <div class="card-header">
                    <h5>Transaction Details</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr>
                            <th>Account Type:</th>
                            <td>@Model.AccountType</td>
                        </tr>
                        <tr>
                            <th>Account Number:</th>
                            <td>@Model.AccountNumber</td>
                        </tr>
                        <tr>
                            <th>Amount:</th>
                            <td>@Model.Amount.ToString("C")</td>
                        </tr>
                        <tr>
                            <th>Comment:</th>
                            <td>@(string.IsNullOrEmpty(Model.Comment) ? "N/A" : Model.Comment)</td>
                        </tr>
                    </table>

                    <form asp-action="Complete" method="post">
                        <button type="submit" class="btn btn-success">Confirm Deposit</button>
                        <a asp-action="Cancel" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>