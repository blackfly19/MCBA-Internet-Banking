@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<MCBA.Models.Transaction>
@{
    var account = (Account)ViewBag.Account;
    var availableBalance = (decimal)ViewBag.AvailableBalance;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10">
            <h2>My Statements</h2>
            <hr />

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Account Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Account Number:</strong> @account.AccountNumber</p>
                            <p><strong>Account Type:</strong> @(account.AccountType == 'C' ? "Checking" : "Savings")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Current Balance:</strong> @account.Balance.ToString("C")</p>
                            <p><strong>Available Balance:</strong> @availableBalance.ToString("C")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Transaction History</h5>
                    <a asp-action="Print" asp-route-accountNumber="@account.AccountNumber" 
                       class="btn btn-primary" target="_blank">
                        <i class="bi bi-printer"></i> Print Transaction History
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>@Html.DisplayNameFor(x => x[0].TransactionID)</th>
                                        <th>Type</th>
                                        <th>@Html.DisplayNameFor(x => x[0].AccountNumber)</th>
                                        <th>Destination</th>
                                        <th>@Html.DisplayNameFor(x => x[0].Amount)</th>
                                        <th>Date & Time</th>
                                        <th>@Html.DisplayNameFor(x => x[0].Comment)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(x => transaction.TransactionID)</td>
                                            <td>
                                                @switch (transaction.TransactionType)
                                                {
                                                    case 'D':
                                                        <span class="badge bg-success">Deposit</span>
                                                        break;
                                                    case 'W':
                                                        <span class="badge bg-warning">Withdraw</span>
                                                        break;
                                                    case 'T':
                                                        <span class="badge bg-info">Transfer</span>
                                                        break;
                                                    case 'S':
                                                        <span class="badge bg-danger">Service Charge</span>
                                                        break;
                                                    case 'B':
                                                        <span class="badge bg-primary">BillPay</span>
                                                        break;
                                                    default:
                                                        @transaction.TransactionType
                                                        break;
                                                }
                                            </td>
                                            <td>@Html.DisplayFor(x => transaction.AccountNumber)</td>
                                            <td>@(transaction.DestinationAccountNumber?.ToString() ?? "N/A")</td>
                                            <td>@Html.DisplayFor(x => transaction.Amount)</td>
                                            <td>@transaction.TransactionTimeUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                                            <td>@(string.IsNullOrEmpty(transaction.Comment) ? "N/A" : transaction.Comment)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @Html.PagedListPager(Model, page => Url.Action("ViewTransactions", new { accountNumber = account.AccountNumber, page }),
                            new PagedListRenderOptions
                            {
                                LiElementClasses = new[] { "page-item" },
                                PageClasses = new[] { "page-link" }
                            })
                    }
                    else
                    {
                        <p class="text-muted">No transactions found for this account.</p>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">Back to Account Selection</a>
            </div>
        </div>
    </div>
</div>