@{
    var accounts = (List<MCBA.Models.Account>)ViewBag.Accounts;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10">
            <h2>My Statements</h2>
            <hr />

            <div class="mb-4">
                <label class="form-label">Select Account:</label>
                <form method="get" asp-action="Index">
                    <div class="input-group" style="max-width: 500px;">
                        <select name="accountNumber" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Select an account --</option>
                            @foreach (var account in accounts)
                            {
                                <option value="@account.AccountNumber">
                                    @(account.AccountType == 'C' ? "Checking" : "Savings") - @account.AccountNumber (Balance: @account.Balance.ToString("C"))
                                </option>
                            }
                        </select>
                    </div>
                </form>
            </div>

            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>