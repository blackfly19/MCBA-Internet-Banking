@model MCBA.ViewModels.ProfileViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>Confirm Profile Changes</h2>
            <hr />

            <div class="card">
                <div class="card-header">
                    <h5>Review Your Changes</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr>
                            <th>Customer ID:</th>
                            <td>@Model.CustomerID</td>
                        </tr>
                        <tr>
                            <th>Name:</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>TFN:</th>
                            <td>@(string.IsNullOrEmpty(Model.TFN) ? "N/A" : Model.TFN)</td>
                        </tr>
                        <tr>
                            <th>Address:</th>
                            <td>@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</td>
                        </tr>
                        <tr>
                            <th>City:</th>
                            <td>@(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City)</td>
                        </tr>
                        <tr>
                            <th>State:</th>
                            <td>@(string.IsNullOrEmpty(Model.State) ? "N/A" : Model.State)</td>
                        </tr>
                        <tr>
                            <th>Postcode:</th>
                            <td>@(string.IsNullOrEmpty(Model.PostCode) ? "N/A" : Model.PostCode)</td>
                        </tr>
                        <tr>
                            <th>Mobile:</th>
                            <td>@(string.IsNullOrEmpty(Model.Mobile) ? "N/A" : Model.Mobile)</td>
                        </tr>
                    </table>

                    <form asp-action="CompleteEdit" method="post">
                        <button type="submit" class="btn btn-success">Confirm Changes</button>
                        <a asp-action="CancelEdit" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>