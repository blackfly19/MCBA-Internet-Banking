@model MCBA.ViewModels.BillPayListViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10">
            <h2>BillPay - Scheduled Payments</h2>
            <hr />

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="mb-3">
                <a asp-action="Create" class="btn btn-primary">Schedule New Payment</a>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Currently Scheduled Bills</h5>
                </div>
                <div class="card-body">
                    @if (Model.ScheduledBills.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Bill ID</th>
                                        <th>Account</th>
                                        <th>Payee</th>
                                        <th>Amount</th>
                                        <th>Next Payment</th>
                                        <th>Frequency</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bill in Model.ScheduledBills)
                                    {
                                        <tr class="@(bill.Status == "Failed" ? "table-danger" : "")">
                                            <td>@bill.BillPayID</td>
                                            <td>
                                                @(bill.Account?.AccountType == 'C' ? "Checking" : "Savings") - @bill.AccountNumber
                                            </td>
                                            <td>@bill.Payee?.Name</td>
                                            <td>@bill.Amount.ToString("C")</td>
                                            <td>@bill.ScheduleTimeUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                                            <td>
                                                @if (bill.Period == 'O')
                                                {
                                                    <span class="badge bg-info">One-off</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Monthly</span>
                                                }
                                            </td>
                                            <td>
                                                @if (bill.Status == "Blocked")
                                                {
                                                    <span class="badge bg-secondary">Blocked</span>
                                                }
                                                else if (bill.Status == "Failed")
                                                {
                                                    <span class="badge bg-danger">Failed - Insufficient Funds</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                @if (bill.Status == "Failed")
                                                {
                                                    <form asp-action="Retry" asp-route-id="@bill.BillPayID" method="post" style="display:inline;">
                                                        <button type="submit" class="btn btn-warning btn-sm">Retry</button>
                                                    </form>
                                                }
                                                <form asp-action="Cancel" asp-route-id="@bill.BillPayID" method="post" style="display:inline;">
                                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to cancel this payment?');">Cancel</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No scheduled payments found.</p>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>