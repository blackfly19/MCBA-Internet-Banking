@model MCBA_AdminPortal.Models.Payee

@{
    ViewData["Title"] = "Edit Payee";
}

<div class="container mt-4">
    <h2>Edit Payee</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="PayeeID" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="State" class="form-label">State</label>
                            <select asp-for="State" class="form-select">
                                <option value="">-- Select State --</option>
                                <option value="ACT">ACT</option>
                                <option value="NSW">NSW</option>
                                <option value="NT">NT</option>
                                <option value="QLD">QLD</option>
                                <option value="SA">SA</option>
                                <option value="TAS">TAS</option>
                                <option value="VIC">VIC</option>
                                <option value="WA">WA</option>
                            </select>
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Postcode" class="form-label">Postcode</label>
                            <input asp-for="Postcode" class="form-control" maxlength="4" />
                            <span asp-validation-for="Postcode" class="text-danger"></span>
                            <small class="form-text text-muted">4 digits</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="(0X) XXXX XXXX" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                            <small class="form-text text-muted">Format: (0X) XXXX XXXX</small>
                        </div>

                        <button type="submit" class="btn btn-success">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>