@model List<MCBA_AdminPortal.Models.BillPay>

@{
    ViewData["Title"] = "Manage BillPay";
}

<div class="container mt-4">
    <h2>Manage Scheduled Bill Payments</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5>Scheduled Bills</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Bill ID</th>
                                <th>Account No.</th>
                                <th>Payee</th>
                                <th>Amount</th>
                                <th>Next Payment</th>
                                <th>Frequency</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in Model)
                            {
                                <tr>
                                    <td>@bill.BillPayID</td>
                                    <td>@bill.AccountNumber</td>
                                    <td>@bill.PayeeID</td>
                                    <td>@bill.Amount.ToString("C")</td>
                                    <td>@bill.ScheduleTimeUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td>
                                        @if (bill.Period == 'O')
                                        {
                                            <span class="badge bg-info">One-off</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Monthly</span>
                                        }
                                    </td>
                                    <td>
                                        @if (bill.Status == "Blocked")
                                        {
                                            <span class="badge bg-secondary">Blocked</span>
                                        }
                                        else if (bill.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (bill.Status == "Blocked")
                                        {
                                            <form asp-action="Unblock" asp-route-id="@bill.BillPayID" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-success">Unblock</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Block" asp-route-id="@bill.BillPayID" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-danger" 
                                                        onclick="return confirm('Are you sure you want to block this payment?');">Block</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No scheduled bill payments found.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>